@model Lab0.Models.AlbumModel

@{
    ViewBag.Title = "Album Details";
    Layout = "_Layout";
}

<h2>@Model.Name</h2>
<p><strong>Band:</strong> @Model.Band</p>
<p><strong>Chart position:</strong> @Model.ChartPosition</p>
<p><strong>Release date:</strong> @Model.ReleaseDate.ToString("yyyy-MM-dd")</p>
<p><strong>Total duration:</strong> @Model.TotalDuration.ToString(@"hh\:mm\:ss")</p>

<h4>Songs</h4>
@if (Model.Songs != null && Model.Songs.Any())
{
    <ul>
        @foreach (var song in Model.Songs)
        {
            <li>@song</li>
        }
    </ul>
}
else
{
    <p>No songs listed.</p>
}
<div class="d-flex align-items-center gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
        <button type="submit" class="btn btn-outline-danger"
                onclick="return confirm('Delete this album?');">
            Delete
        </button>
    </form>
</div>