@model Lab0.Models.Label

@{
    ViewBag.Title = "Label Details";
    Layout = "_Layout";
}

<h2>@Model.Name</h2>

<p><strong>Country:</strong> @(string.IsNullOrEmpty(Model.Country) ? "—" : Model.Country)</p>

<h4>Albums</h4>
@if (Model.Albums != null && Model.Albums.Any())
{
    <ul>
        @foreach (var a in Model.Albums)
        {
            <li>
                @a.Name (@a.Band)
                (<a asp-controller="Album" asp-action="Details" asp-route-id="@a.Id">details</a>)
            </li>
        }
    </ul>
}
else
{
    <p>No albums for this label.</p>
}

<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>