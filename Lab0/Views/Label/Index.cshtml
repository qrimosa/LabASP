@model IEnumerable<Lab0.Models.Label>

@{
    ViewBag.Title = "Labels";
    Layout = "_Layout";
}

<h2>Labels</h2>

<a class="btn btn-outline-primary mb-3" asp-action="Create">
    + Add Label
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No labels found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th style="width: 160px;">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var label in Model)
        {
            <tr>
                <td>@label.Name</td>
                <td>@(string.IsNullOrEmpty(label.Country) ? "—" : label.Country)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@label.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@label.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@label.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}