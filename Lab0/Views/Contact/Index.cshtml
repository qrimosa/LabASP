@model List<Contact>
@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Kontakty</h2>
<a class="btn btn-outline-primary" asp-controller="Contact" asp-action="Create">Dodaj kontakt</a>
<table class="table">
    <thead>
    <th>Imię</th>
    <th>Email</th>
    <th>Operacje</th>
    </thead>
    <tbody>
    @{
        foreach (var contact in Model)
        {
            <tr>
            <td>@(contact.Name)</td>
            <td>@(contact.Email)</td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@contact.Id">Edytuj</a>
                <a class="btn btn-success" asp-action="Details" asp-route-id="@contact.Id">Szczegóły</a>
                <form asp-action="Delete" asp-route-id="@contact.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger"
                            onclick="return confirm('Delete this contact?');">
                        Usuń
                    </button>
                </form>
            </td>
            </tr>
        }
    }
    </tbody>
</table>

