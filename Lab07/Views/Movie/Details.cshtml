@model Lab07.Models.Movies.Movie
@{
    ViewData["Title"] = "Movie details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@Model.Title</h1>

<div class="card mt-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Overview</dt>
            <dd class="col-sm-9">@Model.Overview</dd>

            <dt class="col-sm-3">Release date</dt>
            <dd class="col-sm-9">@Model.ReleaseDate</dd>

            <dt class="col-sm-3">Budget</dt>
            <dd class="col-sm-9">@Model.Budget</dd>

            <dt class="col-sm-3">Revenue</dt>
            <dd class="col-sm-9">@Model.Revenue</dd>

            <dt class="col-sm-3">Runtime</dt>
            <dd class="col-sm-9">@Model.Runtime</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.MovieStatus</dd>

            <dt class="col-sm-3">Tagline</dt>
            <dd class="col-sm-9">@Model.Tagline</dd>

            <dt class="col-sm-3">Popularity</dt>
            <dd class="col-sm-9">@Model.Popularity</dd>

            <dt class="col-sm-3">Vote average</dt>
            <dd class="col-sm-9">@Model.VoteAverage</dd>

            <dt class="col-sm-3">Vote count</dt>
            <dd class="col-sm-9">@Model.VoteCount</dd>

            <dt class="col-sm-3">Homepage</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Homepage))
                {
                    <a href="@Model.Homepage" target="_blank">Open site</a>
                }
                else
                {
                    <span>-</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.MovieId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>
</div>