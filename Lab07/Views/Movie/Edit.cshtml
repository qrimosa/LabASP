@model Lab07.Models.Movies.Movie
@{
ViewData["Title"] = "Edit movie";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit movie</h1>

<form asp-action="Edit" method="post" class="mt-3">
    <input type="hidden" asp-for="MovieId" />

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Overview" class="form-label"></label>
                <textarea asp-for="Overview" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Overview" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label"></label>
                <input asp-for="ReleaseDate" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Homepage" class="form-label"></label>
                <input asp-for="Homepage" class="form-control" />
                <span asp-validation-for="Homepage" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Budget" class="form-label"></label>
                <input asp-for="Budget" class="form-control" />
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Revenue" class="form-label"></label>
                <input asp-for="Revenue" class="form-control" />
                <span asp-validation-for="Revenue" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Runtime" class="form-label"></label>
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MovieStatus" class="form-label"></label>
                <input asp-for="MovieStatus" class="form-control" />
                <span asp-validation-for="MovieStatus" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tagline" class="form-label"></label>
                <input asp-for="Tagline" class="form-control" />
                <span asp-validation-for="Tagline" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Popularity" class="form-label"></label>
                <input asp-for="Popularity" class="form-control" />
                <span asp-validation-for="Popularity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VoteAverage" class="form-label"></label>
                <input asp-for="VoteAverage" class="form-control" />
                <span asp-validation-for="VoteAverage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VoteCount" class="form-label"></label>
                <input asp-for="VoteCount" class="form-control" />
                <span asp-validation-for="VoteCount" class="text-danger"></span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back to list</a>
</form>

@section Scripts{
<partial name="_ValidationScriptsPartial" />
}
